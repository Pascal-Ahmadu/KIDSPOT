# ---- Database ----------------------------------------------------------------
# On Vercel these two come from the Turso integration automatically.
# Leave them out locally to use the SQLite file in DATABASE_URL instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_URL=./data/kidstore.db

# ---- File storage --------------------------------------------------------------
# Set automatically when a Vercel Blob store is connected to the project.
# Without it, uploads and backups are saved under data/files.
# BLOB_READ_WRITE_TOKEN=

# ---- Owner login (required; the site refuses to start in production with these defaults)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me
# Long random string that signs login sessions. Generate one with:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# ---- Site --------------------------------------------------------------------
# The public address of the shop, used in invoice links, WhatsApp receipts and the Monnify webhook.
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_STORE_NAME="Kid's Spot"
NEXT_PUBLIC_STORE_HANDLE=kidsspot
NEXT_PUBLIC_CURRENCY=NGN

# Contact details, address and social links are edited in Admin -> Settings -> Store details.
